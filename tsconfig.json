{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./pages/*"],
      "@test-data/*": ["./test-data/*"],
      "@data-types/*": ["./data-types/*"],
      "@utils/*": ["./utils/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report"]
}
