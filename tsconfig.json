{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./pages/*"],
      "@test-data/*": ["./test-data/*"],
      "@data-type/*": ["./data-type/*"],
      "@util/*": ["./util/*"]
    }
  },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "my-report", "test-results"]
}